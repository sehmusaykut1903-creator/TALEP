{
  "entities": {
    "patient": {
      "title": "Patient",
      "description": "Patient information and history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "occupation": { "type": "string" },
        "sector": { "type": "string" },
        "workDuration": { "type": "string" },
        "ppeUsage": { "type": "boolean" },
        "smoking": { "type": "boolean" },
        "comorbidities": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "sector"]
    },
    "assessment": {
      "title": "Assessment",
      "description": "Toxicological matching assessment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "symptoms": { "type": "array" },
        "labResults": { "type": "object" },
        "matchedChemicals": { "type": "array" },
        "riskScore": { "type": "number" },
        "riskLevel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "patients": {
      "schema": "patient",
      "description": "Collection of patient profiles"
    },
    "assessments": {
      "schema": "assessment",
      "description": "Collection of toxicological assessments"
    }
  }
}
