rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Reusable Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- 1. Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) 
        && incoming().email is string 
        && incoming().displayName is string;
      allow update: if isOwner(userId)
        && incoming().displayName is string;
      allow delete: if isOwner(userId);
    }

    // --- 2. Cases & Backward Compatibility ---
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 128
        && incoming().sector is string && incoming().sector.size() <= 64;
      allow update: if isSignedIn()
        && incoming().name is string
        && incoming().sector is string;
      allow delete: if isSignedIn();
    }

    match /toxicology_cases/{caseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 128
        && incoming().sector is string && incoming().sector.size() <= 64;
      allow update: if isSignedIn()
        && incoming().name is string
        && incoming().sector is string;
      allow delete: if isSignedIn();
    }

    // --- 3. Analyses / Assessments ---
    match /analyses/{analysisId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().caseId is string
        && incoming().riskScore is number;
      allow update: if isSignedIn()
        && incoming().caseId is string;
      allow delete: if isSignedIn();
    }

    match /ai_assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().caseId is string
        && incoming().matchedChemicals is list
        && incoming().riskScore is number;
      allow update: if isSignedIn()
        && incoming().caseId is string;
      allow delete: if isSignedIn();
    }

    // --- 4. Literature Reference Collection ---
    match /literature/{docId} {
      allow read: if true;
      allow write: if isSignedIn()
        && incoming().title is string;
    }

    // --- 5. Chemicals Reference Collection ---
    match /chemicals/{chemicalId} {
      allow read: if true;
      allow write: if isSignedIn()
        && incoming().name is string;
    }

    // --- 6. Biomarkers Reference tables ---
    match /biomarkers/{biomarkerId} {
      allow read: if true;
      allow write: if isSignedIn()
        && incoming().markerName is string;
    }

    // --- 7. Epidemiology Dataset Mappings ---
    match /epidemiology/{epiId} {
      allow read: if true;
      allow write: if isSignedIn()
        && incoming().sector is string;
    }

    // --- 8. AI Responses Cache ---
    match /ai_cache/{cacheId} {
      allow read: if true;
      allow write: if isSignedIn()
        && incoming().prompt is string;
    }

    // --- 9. Generated Medical Reports ---
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().caseId is string
        && incoming().title is string;
      allow update: if isSignedIn()
        && incoming().caseId is string;
      allow delete: if isSignedIn();
    }

    // --- 10. Cooperating Institutions ---
    match /institutions/{instId} {
      allow read: if true;
      allow write: if isSignedIn()
        && incoming().name is string;
    }

    // --- System / Back-compat Tables ---
    match /laboratory_results/{resultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().caseId is string
        && incoming().testName is string
        && incoming().value is string;
      allow update: if isSignedIn()
        && incoming().caseId is string
        && incoming().testName is string;
      allow delete: if isSignedIn();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().title is string
        && incoming().message is string;
      allow update: if isSignedIn()
        && incoming().read is bool;
      allow delete: if isSignedIn();
    }

    match /ai_chat_memories/{memoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().sessionId is string
        && incoming().question is string;
      allow update: if isSignedIn()
        && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn()
        && existing().userId == request.auth.uid;
    }
  }
}
