rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Default Deny Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Reusable Handlers & Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate timestamp on creation or update
    function isCreateTimeValid(data) {
      return data.createdAt == request.time;
    }

    function isUpdateTimeValid(data) {
      return data.updatedAt == request.time;
    }

    // --- 1. Users Collection ---
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- 2. Cases and Backward-Compatible Toxicology Cases ---
    function isValidCase(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.sector is string && data.sector.size() <= 128;
    }

    match /cases/{caseId} {
      allow get: if isSignedIn() && isValidId(caseId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(caseId) && isValidCase(incoming());
      allow update: if isSignedIn() && isValidId(caseId) && isValidCase(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'age', 'gender', 'sector', 'unit', 'duration', 'ppeUsage', 'symptoms', 'risk', 'notes']);
      allow delete: if isSignedIn() && isValidId(caseId);
    }

    match /toxicology_cases/{caseId} {
      allow get: if isSignedIn() && isValidId(caseId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(caseId) && isValidCase(incoming());
      allow update: if isSignedIn() && isValidId(caseId) && isValidCase(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'age', 'gender', 'sector', 'unit', 'duration', 'ppeUsage', 'symptoms', 'risk', 'notes']);
      allow delete: if isSignedIn() && isValidId(caseId);
    }

    // --- 3. Clinical Laboratory Results ---
    function isValidLabResult(data) {
      return data.caseId is string && data.caseId.size() <= 128 &&
             data.testName is string && data.testName.size() <= 128;
    }

    match /laboratory_results/{resultId} {
      allow get: if isSignedIn() && isValidId(resultId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(resultId) && isValidLabResult(incoming());
      allow update: if isSignedIn() && isValidId(resultId) && isValidLabResult(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['testName', 'value', 'isAbnormal', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(resultId);
    }

    // --- 4. Scientific Assessments / AI Decisions ---
    function isValidAssessment(data) {
      return data.caseId is string && data.caseId.size() <= 128 &&
             data.riskScore is number;
    }

    match /ai_assessments/{assessmentId} {
      allow get: if isSignedIn() && isValidId(assessmentId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(assessmentId) && isValidAssessment(incoming());
      allow update: if isSignedIn() && isValidId(assessmentId) && isValidAssessment(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['matchedChemicals', 'riskScore', 'clinicalAdvice', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(assessmentId);
    }

    // --- 5. Clinical Reference Collections (Read-Only to Public, Write to Authenticated) ---
    match /literature/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && incoming().title is string && incoming().title.size() <= 256;
    }

    match /chemicals/{chemicalId} {
      allow read: if true;
      allow write: if isSignedIn() && incoming().name is string && incoming().name.size() <= 128;
    }

    match /biomarkers/{biomarkerId} {
      allow read: if true;
      allow write: if isSignedIn() && incoming().markerName is string && incoming().markerName.size() <= 128;
    }

    match /epidemiology/{epiId} {
      allow read: if true;
      allow write: if isSignedIn() && incoming().sector is string && incoming().sector.size() <= 128;
    }

    match /institutions/{instId} {
      allow read: if true;
      allow write: if isSignedIn() && incoming().name is string && incoming().name.size() <= 128;
    }

    // --- 6. AI LLM Prompt & Reply Caching ---
    match /ai_cache/{cacheId} {
      allow read: if true;
      allow create, update: if isSignedIn() && incoming().prompt is string && incoming().prompt.size() <= 10000;
      allow delete: if isSignedIn();
    }

    // --- 7. Enterprise Reports Collection (PDF Module) ---
    function isValidReport(data) {
      return data.patientName is string && data.patientName.size() <= 128 &&
             data.patientSector is string && data.patientSector.size() <= 128;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reportId) && isValidReport(incoming());
      allow update: if isSignedIn() && isValidId(reportId) && isValidReport(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['patientName', 'patientAgeSex', 'patientSector', 'patientUnit', 'exposureDuration', 'severity', 'template', 'symptoms', 'biomarkers', 'clinicalText', 'nextActions']);
      allow delete: if isSignedIn() && isValidId(reportId);
    }

    // --- 8. System Notifications Feed ---
    match /notifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().title is string && incoming().title.size() <= 256;
      allow update: if isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn();
    }

    // --- 9. AI Copilot Chat Memory Logs ---
    match /ai_chat_memories/{memoryId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid
        && incoming().sessionId is string && incoming().question is string;
      allow update: if isSignedIn() && incoming().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['question', 'answer', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
